# Database
DATABASE_URL="file:./dev.db"

# Auth & Security
PORT=5000
JWT_SECRET="super-secret-jwt-key-min-32-chars-long-change-in-prod"
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Groq API
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-api03-sample"
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/oauth/google/callback"

# Microsoft OAuth 2.0
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:5000/api/oauth/microsoft/callback"

# MCP Server
MCP_SERVER_PORT=5001
MCP_SERVER_URL="http://localhost:5001"
VITE_API_BASE_URL="http://localhost:5000"
